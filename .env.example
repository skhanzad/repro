OPENAI_API_KEY=sk-...
# Optional: raises the GitHub API limit for scripts/scrape_github.py from 60 to 5000 req/hour
GITHUB_TOKEN=
# Optional: point the "openai" provider at another OpenAI-compatible server (vLLM, OpenRouter, ...)
# OPENAI_BASE_URL=http://localhost:8000/v1

# Providers: openai | ollama. Models default per provider if unset.
REPRO_AGENT_PROVIDER=openai
# REPRO_AGENT_MODEL=gpt-5-mini
REPRO_JUDGE_PROVIDER=openai
# REPRO_JUDGE_MODEL=gpt-5-mini
# Bug classifier: cheap model, escalating to a stronger one when unsure ("" disables)
REPRO_CLASSIFIER_PROVIDER=openai
# REPRO_CLASSIFIER_MODEL=gpt-5-nano
REPRO_ESCALATION_PROVIDER=openai
# REPRO_ESCALATION_MODEL=gpt-5-mini
REPRO_ESCALATE_BELOW=0.7

REPRO_OLLAMA_BASE_URL=http://localhost:11434/v1

REPRO_MAX_STEPS=10
REPRO_CONCURRENCY=8
